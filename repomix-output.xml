                    height: 8,
                    width: `${(n / total.p) * 100}%`,
                    transition: "width 0.5s",
                  }}
                />
              </div>
            </div>
          ))}
          <div
            style={{
              marginTop: 20,
              background: C.okL,
              borderRadius: 10,
              padding: "14px 16px",
