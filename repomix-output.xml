                      <span
                        style={{
                          display: "inline-block",
                          fontSize: 10,
                          fontWeight: 600,
                          background: "#E2E8F0",
                          color: "#475569",
                          padding: "2px 8px",
                          borderRadius: 6,
                          maxWidth: "75%",
                          overflow: "hidden",
                          textOverflow: "ellipsis",
                          whiteSpace: "nowrap",
                        }}
                      >
                        📦 {conv.productName}
                      </span>

                      {conv.unread > 0 && (
                        <div
                          style={{
                            background: C.coral,
                            color: "#fff",
                            borderRadius: 10,
                            padding: "1px 8px",
                            fontSize: 10,
                            fontWeight: 700,
                            flexShrink: 0,
                            boxShadow: "0 2px 6px rgba(232, 100, 58, 0.3)",
