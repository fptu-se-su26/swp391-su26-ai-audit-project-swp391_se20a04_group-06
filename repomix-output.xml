  align-items: center;
  gap: 8px;
}

.hamburger {
  background: #fff;
  color: #475569;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  width: 38px;
  height: 38px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ─── MOBILE MENU ────────────────────────────────────────── */
.mobileMenu {
  background: #fff;
  border-bottom: 1px solid #e2e8f0;
  padding: 12px 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  position: sticky;
  top: 58px;
  z-index: 998;
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
}

.mobileMenuItem {
  background: #f8fafc;
  color: #334155;
  border: none;
  padding: 12px 16px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 14px;
