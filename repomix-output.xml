            <span style={{ fontSize: 12, color: C.muted, fontWeight: 700 }}>
              Đã chọn: {images.length} / 5 ảnh tối đa
            </span>
          )}
        </div>

        {/* Drop zone thiết kế tròn bo */}
        <label
          style={{
            display: "block",
            border: `2px dashed ${images.length > 0 ? C.ok : C.border}`,
