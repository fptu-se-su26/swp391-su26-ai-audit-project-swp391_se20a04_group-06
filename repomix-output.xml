  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
  align-items: flex-end;
  box-shadow: var(--shadow-md);
  animation: fadeUp 0.2s ease both;
  margin-bottom: 20px;
}

.filterGroup label {
  display: block;
  font-size: 11px;
  font-weight: 700;
  color: var(--muted);
  margin-bottom: 7px;
  letter-spacing: 0.03em;
}

.filterInputRow {
  display: flex;
  gap: 8px;
  align-items: center;
}

.filterSep {
  color: var(--muted);
  font-size: 12px;
}

.filterInput {
  width: 110px;
  padding: 8px 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 13px;
  outline: none;
  color: var(--text);
  background: var(--bg);
  transition: border-color 0.15s;
}

.filterInput:focus {
  border-color: var(--ocean);
}

.clearBtn {
  padding: 8px 16px;
  border-radius: var(--radius-sm);
  border: none;
  background: #fee2e2;
  color: #991b1b;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s;
  display: flex;
  align-items: center;
  gap: 5px;
}

.clearBtn:hover {
  background: #fecaca;
}

/* ─── SORT + VIEW ROW ────────────────────────────────────── */
.sortRow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22px;
  flex-wrap: wrap;
  gap: 10px;
}

.sortLabel {
  font-size: 12px;
  color: var(--muted);
  font-weight: 500;
}

.sortSelect {
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 7px 12px;
  font-size: 12px;
  background: var(--white);
  cursor: pointer;
  color: var(--text);
  outline: none;
  box-shadow: var(--shadow-sm);
  font-weight: 500;
}

.sortLeft {
  display: flex;
  align-items: center;
  gap: 8px;
}

.viewToggle {
  display: flex;
  background: var(--bg-2);
  border-radius: var(--radius-sm);
  padding: 3px;
  overflow: hidden;
}

.viewBtn {
  padding: 7px 14px;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  font-weight: 700;
  font-size: 12px;
  background: transparent;
  color: var(--muted);
  transition:
    background 0.18s,
    color 0.18s,
    box-shadow 0.18s;
  display: flex;
  align-items: center;
  gap: 5px;
}

.viewBtn.active {
  background: var(--white);
  color: var(--ocean);
  box-shadow: var(--shadow-sm);
}

/* ─── INFO BANNER ────────────────────────────────────────── */
.infoBanner {
  background: var(--ocean-p);
  border: 1px solid rgba(26, 127, 160, 0.2);
  border-left: 3px solid var(--ocean-l);
  border-radius: var(--radius-md);
  padding: 11px 16px;
  margin-bottom: 20px;
  font-size: 12px;
  color: var(--ocean);
  display: flex;
  align-items: flex-start;
  gap: 8px;
}

/* ─── ERROR BANNER ───────────────────────────────────────── */
.errorBanner {
  background: #fef2f2;
  color: #991b1b;
  border-radius: var(--radius-md);
  padding: 11px 16px;
  margin-bottom: 20px;
  font-size: 13px;
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid #fecaca;
  border-left: 3px solid #ef4444;
}

/* ─── PRODUCT GRID ───────────────────────────────────────── */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 20px;
}

/* ─── EMPTY STATE ────────────────────────────────────────── */
.empty {
  text-align: center;
  padding: 72px 20px;
  color: var(--muted);
  background: var(--white);
  border-radius: var(--radius-xl);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
}

.emptyIcon {
  font-size: 52px;
  margin-bottom: 12px;
  opacity: 0.6;
}

.emptyTitle {
  font-size: 16px;
  font-weight: 800;
  color: var(--dark);
  margin-bottom: 6px;
}

.emptyBody {
  font-size: 13px;
  color: var(--muted);
}

/* ─── LOAD MORE / END ────────────────────────────────────── */
.endLabel {
  text-align: center;
  padding: 32px 0 12px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

/* ─── RESPONSIVE POLISH (Cải tiến giao diện Mobile) ──────── */
@media (max-width: 768px) {
  .hero {
    height: 340px; /* Thu bớt chiều cao banner */
    margin-bottom: 24px;
  }
  .heroArrow {
    display: none !important; /* Ẩn các mũi tên đè chữ vướng víu trên mobile */
  }
  .heroContent {
    padding: 0 16px !important;
  }
  .heroCard {
    padding: 18px 20px !important;
    margin: 0 !important;
    max-width: 100% !important;
    border-radius: 14px !important;
  }
  .heroH1 {
    font-size: 22px !important; /* Giảm font chữ tiêu đề tránh chồng dòng */
    line-height: 1.25 !important;
  }
  .heroLead {
    font-size: 12px !important;
    margin-bottom: 16px !important;
    line-height: 1.5 !important;
  }
  .heroGpsBtn {
    padding: 8px 14px !important;
    font-size: 12px !important;
  }

  /* main container */
  .content {
    padding: 0 16px 60px !important;
  }

  .searchWrap {
    margin-bottom: 16px;
  }
  .searchInput {
    padding: 11px 14px 11px 38px !important;
    font-size: 13px !important;
  }

  /* ─── TÁI CẤU TRÚC CUỘN NGANG FILTER CHIPS (MOBILE CHUẨN) ─── */
  .filterRow {
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 12px !important;
    margin-bottom: 16px !important;
  }

  .tabGroup {
    width: 100% !important;
    display: flex !important;
  }
  .tab {
    flex: 1 !important; /* Chia đều 2 tab chính */
    text-align: center !important;
    padding: 8px 10px !important;
    font-size: 12px !important;
  }

  /* Hiệu ứng cuộn ngang tràn lề cực mượt chuẩn Native App */
  .chipGroup {
    flex-wrap: nowrap !important;
    overflow-x: auto !important;
    padding: 4px 16px !important;
    margin-left: -16px; /* Đẩy lùi lề trái sát viền */
    margin-right: -16px; /* Đẩy lùi lề phải sát viền */
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Ẩn thanh cuộn Firefox */
  }
  .chipGroup::-webkit-scrollbar {
    display: none; /* Ẩn thanh cuộn Chrome, Safari */
  }
  .chip {
    flex-shrink: 0 !important; /* Ngăn thẻ chip bị co ép kích thước */
    padding: 6px 14px !important;
    font-size: 11px !important;
  }

  .advancedToggle {
    margin-bottom: 16px;
    font-size: 11px !important;
    padding: 6px 12px !important;
  }
  .sortRow {
    margin-bottom: 16px;
  }
}

@media (max-width: 640px) {
  .grid {
    grid-template-columns: 1fr 1fr; /* Chia 2 cột card sản phẩm đều đặn */
    gap: 12px;
  }
}

@media (max-width: 380px) {
  .grid {
    grid-template-columns: 1fr; /* Màn hình siêu nhỏ quay về 1 cột */
  }
}
