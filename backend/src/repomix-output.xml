         */
        CommentResponse: {
          type: "object",
          properties: {
            id: { type: "string", example: "64df56e9c40212f8e12345bb" },
            text: { type: "string", example: "Cảm ơn tác giả đã chia sẻ!" },
            authorId: { type: "string", example: "64df56e9c40212f8e1234567" },
            createdAt: { type: "string", format: "date-time" },
