         * - likesCount   → Số người đã thích công thức này
         */
        RecipeResponse: {
          type: "object",
          properties: {
            id: { type: "string", example: "64df56e9c40212f8e12345cc" },
            title: { type: "string", example: "Lẩu thái hải sản chua cay" },
            description: {
              type: "string",
              example: "Công thức chế biến đơn giản chuẩn vị",
