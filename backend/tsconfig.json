{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": [
    "node_modules",
    "dist"
    // "src/**/*.test.ts", // Loại bỏ file test khỏi bản build sản phẩm
    // "src/**/*.spec.ts" // Loại bỏ file spec khỏi bản build sản phẩm
  ]
}
