            fontWeight: n.isRead ? 400 : 700,
            color: n.isRead ? C.text : C.dark,
          }}
        >
          {n.preview || n.content}
        </div>
        {n.createdAt && (
          <div
            style={{
              fontSize: 11,
              color: C.muted,
              marginTop: 6,
              display: "flex",
              alignItems: "center",
              gap: 4,
            }}
          >
            <span>🕒</span>
            <span>
              {new Date(n.createdAt).toLocaleTimeString([], {
                hour: "2-digit",
                minute: "2-digit",
              })}
