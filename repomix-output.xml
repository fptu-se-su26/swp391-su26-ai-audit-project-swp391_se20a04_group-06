      >
        {loading
          ? "⏳ Đang đăng bài bán..."
          : postCount.count >= postCount.max && !postCount.isPremium
            ? "🌟 Nâng cấp Premium để mở khoá Đăng bài"
            : "🚀 Đăng mẻ hàng ngay"}
      </button>
    </div>
  );
}
