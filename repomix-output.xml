}

/* ─── CSS VIEW TRANSITIONS ──────────────────────────────── */
/* Native page-transition fade/slide khi chuyển route       */

::view-transition-old(root) {
  animation: vtFadeOut 0.18s ease-out both;
}

::view-transition-new(root) {
  animation: vtSlideIn 0.28s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes vtFadeOut {
  from {
