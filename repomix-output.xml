                      fontWeight: 600,
                      background: "#F1F5F9",
                      color: "#475569",
                      padding: "2px 8px",
                      borderRadius: 6,
                      maxWidth: "100%",
                      overflow: "hidden",
                      textOverflow: "ellipsis",
                      whiteSpace: "nowrap",
                    }}
                  >
                    📦 {c.productName}
                  </span>
                </div>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  );
}
