}

/* Tất cả elements kế thừa font */
button,
input,
select,
textarea {
  font-family: var(--font);
}

/* ─── SCROLLBAR ─────────────────────────────────────────── */
::-webkit-scrollbar {
  width: 5px;
  height: 5px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: rgba(11, 79, 108, 0.18);
  border-radius: 99px;
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(11, 79, 108, 0.35);
}

/* ─── SELECTION ─────────────────────────────────────────── */
::selection {
  background: rgba(11, 79, 108, 0.15);
  color: var(--ocean-d);
}

/* ─── ANIMATIONS ─────────────────────────────────────────── */
@keyframes shimmer {
  0% {
    background-position: -600px 0;
  }
  100% {
    background-position: 600px 0;
  }
}

@keyframes pulse-danger {
  0% {
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.6);
  }
  70% {
    box-shadow: 0 0 0 8px rgba(239, 68, 68, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
  }
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ─── UTILITY CLASSES ───────────────────────────────────── */
.skeleton-shimmer {
  background-color: #ebf0f7;
  background-image: linear-gradient(
    90deg,
    #ebf0f7 0%,
    #dde3ec 40%,
    #ebf0f7 80%,
    #ebf0f7 100%
  );
  background-size: 600px 100%;
  background-repeat: no-repeat;
  animation: shimmer 1.4s ease-in-out infinite;
}

.pulse-urgent {
  animation: pulse-danger 1.8s ease infinite;
}

.fade-up {
  animation: fadeUp 0.35s ease both;
}

/* ─── RESPONSIVE GRID ───────────────────────────────────── */
@media (max-width: 640px) {
  .product-grid {
    grid-template-columns: 1fr 1fr !important;
    gap: 12px !important;
  }
}
@media (max-width: 380px) {
  .product-grid {
    grid-template-columns: 1fr !important;
  }
}

/* ─── CSS VIEW TRANSITIONS ──────────────────────────────── */
/* Native page-transition fade/slide khi chuyển route       */

::view-transition-old(root) {
  animation: vtFadeOut 0.18s ease-out both;
}

::view-transition-new(root) {
  animation: vtSlideIn 0.28s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes vtFadeOut {
  from {
    opacity: 1;
    transform: translateY(0);
  }
  to {
    opacity: 0;
    transform: translateY(-6px);
  }
}

@keyframes vtSlideIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Giảm chuyển động khi người dùng bật prefers-reduced-motion */
@media (prefers-reduced-motion: reduce) {
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }
}
