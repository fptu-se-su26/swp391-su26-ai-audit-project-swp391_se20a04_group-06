                letterSpacing: "0.05em",
                display: "block",
                marginBottom: 6,
              }}
            >
              Tên sản phẩm *
            </label>
            <input
              value={form.name}
              onChange={set("name")}
              style={inp}
              placeholder="VD: Cá Thu Tươi..."
