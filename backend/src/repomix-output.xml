// Khởi tạo lược đồ postSchema dành cho bộ sưu tập Post
const postSchema = new Schema<IPost>(
  {
    // Cấu hình trường userId: liên kết với bộ sưu tập User, bắt buộc nhập và đánh index để truy vấn theo tác giả nhanh hơn
