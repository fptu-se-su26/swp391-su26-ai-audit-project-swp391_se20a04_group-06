                    #{u.id}
                  </td>
                  <td
                    style={{
                      padding: "12px 16px",
                      fontWeight: 600,
                      fontSize: 14,
                    }}
                  >
                    {u.name}
                  </td>
                  <td
                    style={{
                      padding: "12px 16px",
                      fontSize: 13,
                      color: C.muted,
                    }}
                  >
                    {u.phone}
                  </td>
                  <td style={{ padding: "12px 16px", fontSize: 13 }}>
                    {u.posts}
                  </td>
                  <td style={{ padding: "12px 16px" }}>
                    {u.active
                      ? pill(C.okL, C.ok, "● Hoạt động")
                      : pill("#FEE2E2", "#991B1B", "● Bị khoá")}
