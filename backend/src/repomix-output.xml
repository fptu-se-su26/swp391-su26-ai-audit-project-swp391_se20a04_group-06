  const mockProductId = "60c72b2f9b1d8b2bad000003";

  // Hàm chạy trước mỗi ca kiểm thử đơn lẻ để dọn dẹp các thiết lập cũ
  beforeEach(() => {
    // Xóa sạch lịch sử gọi hàm của các module mock
