              <span
                style={{
                  background: C.coral,
                  color: "#fff",
                  borderRadius: 20,
                  padding: "2px 10px",
                  fontSize: 11,
                  fontWeight: 700,
                  boxShadow: "0 2px 8px rgba(232, 100, 58, 0.45)",
