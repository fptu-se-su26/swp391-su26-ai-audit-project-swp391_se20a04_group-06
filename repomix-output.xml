    transform: translateY(0);
  }
}

/* Giảm chuyển động khi người dùng bật prefers-reduced-motion */
@media (prefers-reduced-motion: reduce) {
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }
}
