/* ─── RESPONSIVE BREAKPOINT ─────────────────────────────── */
@media (max-width: 768px) {
  .topBar {
    display: none !important; /* Ẩn topbar tràn chữ */
  }
  .nav {
    height: 56px !important; /* Thu gọn chiều cao header */
    padding: 0 16px !important;
  }
  .navScrolled {
    height: 56px !important;
  }
  .navLinks {
    display: none !important; /* Ẩn thanh điều hướng desktop */
  }
  .actions {
    display: none !important; /* Ẩn các nút Profile desktop */
  }
  .mobileActions {
    display: flex !important; /* Kích hoạt nút Hamburger và Chat di động */
  }
  .logoMark {
    width: 32px !important;
    height: 32px !important;
  }
  .logoName {
    font-size: 14px !important;
  }
  .logoTagline {
    font-size: 7px !important;
  }
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
