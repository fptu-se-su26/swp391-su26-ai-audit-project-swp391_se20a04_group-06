    maxWidth: 420,
  },
  logo: {
    fontSize: 28,
    marginBottom: 8,
    textAlign: "center",
  },
  title: {
    fontSize: 20,
    fontWeight: 800,
    color: "var(--dark)",
    textAlign: "center",
    margin: 0,
  },
  sub: {
    fontSize: 13,
    color: "var(--muted)",
    textAlign: "center",
    marginTop: 6,
    marginBottom: 28,
    lineHeight: 1.6,
  },
  label: {
    fontSize: 12,
    fontWeight: 600,
    color: "var(--muted)",
    marginBottom: 6,
    display: "block",
    textTransform: "uppercase",
    letterSpacing: "0.05em",
  },
  input: {
    width: "100%",
    padding: "12px 14px",
