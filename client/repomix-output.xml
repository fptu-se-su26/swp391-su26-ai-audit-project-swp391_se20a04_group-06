                      textAlign: "center",
                      borderRadius: "0 0 8px 8px",
                      padding: "2px 0",
                    }}
                  >
                    Ảnh bìa chính
                  </div>
                )}
                {/* Nút xóa ảnh đỏ rực rỡ có viền trắng */}
                <button
                  onClick={() =>
                    setImages((prev) => prev.filter((_, j) => j !== i))
