/* ── Tablet portrait (641–768px) ── */
@media (max-width: 768px) and (min-width: 641px) {
  .hero {
    height: 320px;
    margin-bottom: 20px;
  }
  .heroArrow {
    display: none;
  }
  .heroH1 {
    font-size: 24px;
    line-height: 1.25;
  }
  .heroLead {
    font-size: 13px;
    margin-bottom: 18px;
  }
  .heroCard {
    padding: 22px 24px;
    max-width: 100%;
    border-radius: 16px;
  }
  .heroContent {
    padding: 0 20px;
    align-items: flex-end;
    padding-bottom: 36px;
  }
  .content {
    padding: 0 20px 60px;
  }
  .grid {
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .filterRow {
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    margin-bottom: 14px;
  }
  .tabGroup {
    width: 100%;
  }
  .tab {
    flex: 1;
    text-align: center;
    font-size: 12px;
    padding: 8px 10px;
  }
  .chipGroup {
    flex-wrap: nowrap;
    overflow-x: auto;
    padding: 4px 20px;
    margin-left: -20px;
    margin-right: -20px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .chipGroup::-webkit-scrollbar {
    display: none;
  }
  .chip {
    flex-shrink: 0;
  }
}

/* ── Mobile (≤ 768px) ── */
@media (max-width: 768px) {
  .hero {
    height: 340px;
    margin-bottom: 24px;
  }
  .heroArrow {
    display: none !important;
  }
  .heroContent {
    padding: 0 16px !important;
  }
  .heroCard {
    padding: 18px 20px !important;
    margin: 0 !important;
    max-width: 100% !important;
    border-radius: 14px !important;
  }
  .heroH1 {
    font-size: 22px !important;
    line-height: 1.25 !important;
  }
  .heroLead {
    font-size: 12px !important;
    margin-bottom: 16px !important;
    line-height: 1.5 !important;
  }
  .heroGpsBtn {
    padding: 8px 14px !important;
    font-size: 12px !important;
  }
  .content {
    padding: 0 16px 60px !important;
  }
  .searchWrap {
    margin-bottom: 16px;
  }
  .searchInput {
    padding: 11px 14px 11px 38px !important;
    font-size: 13px !important;
  }
  .filterRow {
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 12px !important;
    margin-bottom: 16px !important;
  }
  .tabGroup {
    width: 100% !important;
    display: flex !important;
  }
  .tab {
    flex: 1 !important;
    text-align: center !important;
    padding: 8px 10px !important;
    font-size: 12px !important;
  }
  .chipGroup {
    flex-wrap: nowrap !important;
    overflow-x: auto !important;
    padding: 4px 16px !important;
    margin-left: -16px;
    margin-right: -16px;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .chipGroup::-webkit-scrollbar {
    display: none;
  }
  .chip {
    flex-shrink: 0 !important;
    padding: 6px 14px !important;
    font-size: 11px !important;
  }
  .advancedToggle {
    margin-bottom: 16px;
    font-size: 11px !important;
    padding: 6px 12px !important;
  }
  .advancedPanel {
    padding: 14px 16px;
    gap: 14px;
  }
  .filterInput {
    width: 90px !important;
  }
  .sortRow {
    margin-bottom: 16px;
