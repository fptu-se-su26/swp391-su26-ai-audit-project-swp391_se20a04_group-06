            ingredients: { type: "array", items: { type: "string" } },
            instructions: { type: "array", items: { type: "string" } },
            imageUrl: { type: "string", nullable: true },
            difficulty: {
              type: "string",
              enum: ["Easy", "Medium", "Hard"],
              example: "Medium",
            },
