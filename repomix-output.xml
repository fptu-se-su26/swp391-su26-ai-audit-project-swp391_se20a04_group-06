        }}
      >
        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            marginBottom: 14,
          }}
        >
          <div
            style={{
              fontWeight: 800,
              fontSize: 13,
              color: C.muted,
              textTransform: "uppercase",
              letterSpacing: "0.05em",
            }}
          >
            📸 Hình ảnh thực tế của mẻ hàng
          </div>
