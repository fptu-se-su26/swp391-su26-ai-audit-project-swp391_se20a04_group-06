              {
                method: "POST",
                body: fd,
              }
            );

            if (!cloudRes.ok) {
              throw new Error("Tải ảnh trực tiếp lên máy chủ CDN thất bại.");
            }

            const cloudData = await cloudRes.json();
            return cloudData.secure_url; // Trả về đường dẫn CDN
