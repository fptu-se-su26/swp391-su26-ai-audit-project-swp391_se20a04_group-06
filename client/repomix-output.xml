  --bg: #f4f7fb;
  --bg-2: #ebf0f7;
  --white: #ffffff;
  --shadow-sm:
    0 1px 3px rgba(15, 27, 41, 0.08), 0 1px 2px rgba(15, 27, 41, 0.04);
  --shadow-md:
    0 4px 12px rgba(15, 27, 41, 0.1), 0 2px 4px rgba(15, 27, 41, 0.06);
  --shadow-lg:
    0 10px 28px rgba(15, 27, 41, 0.12), 0 4px 8px rgba(15, 27, 41, 0.06);
  --shadow-xl:
    0 20px 40px rgba(11, 79, 108, 0.15), 0 8px 16px rgba(11, 79, 108, 0.07);
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --radius-xl: 20px;
  --radius-2xl: 28px;
  --font:
    "Be Vietnam Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --transition: 0.22s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ─── TYPOGRAPHY BASE ───────────────────────────────────── */
html {
  font-size: 16px;
  -webkit-text-size-adjust: 100%;
}

body {
  font-family: var(--font);
  font-size: 0.9375rem;
  line-height: 1.6;
  color: var(--text);
  background-color: var(--bg);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-feature-settings:
    "kern" 1,
    "liga" 1,
    "calt" 1;
}

/* Tất cả elements kế thừa font */
button,
input,
select,
textarea {
  font-family: var(--font);
}

/* ─── SCROLLBAR ─────────────────────────────────────────── */
::-webkit-scrollbar {
  width: 5px;
  height: 5px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: rgba(11, 79, 108, 0.18);
  border-radius: 99px;
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(11, 79, 108, 0.35);
}

/* ─── SELECTION ─────────────────────────────────────────── */
::selection {
  background: rgba(11, 79, 108, 0.15);
  color: var(--ocean-d);
}

/* ─── ANIMATIONS ─────────────────────────────────────────── */
@keyframes shimmer {
  0% {
    background-position: -600px 0;
  }
  100% {
    background-position: 600px 0;
  }
}

@keyframes pulse-danger {
  0% {
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.6);
  }
  70% {
    box-shadow: 0 0 0 8px rgba(239, 68, 68, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
  }
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ─── UTILITY CLASSES ───────────────────────────────────── */
.skeleton-shimmer {
  background-color: #ebf0f7;
  background-image: linear-gradient(
    90deg,
    #ebf0f7 0%,
    #dde3ec 40%,
    #ebf0f7 80%,
    #ebf0f7 100%
  );
  background-size: 600px 100%;
  background-repeat: no-repeat;
  animation: shimmer 1.4s ease-in-out infinite;
}

.pulse-urgent {
  animation: pulse-danger 1.8s ease infinite;
}

.fade-up {
  animation: fadeUp 0.35s ease both;
}

/* ─── RESPONSIVE GRID ───────────────────────────────────── */
@media (max-width: 640px) {
  .product-grid {
    grid-template-columns: 1fr 1fr !important;
    gap: 12px !important;
  }
}
@media (max-width: 380px) {
  .product-grid {
    grid-template-columns: 1fr !important;
  }
}

/* ─── CSS VIEW TRANSITIONS ──────────────────────────────── */
/* Native page-transition fade/slide khi chuyển route       */

::view-transition-old(root) {
  animation: vtFadeOut 0.18s ease-out both;
}

::view-transition-new(root) {
  animation: vtSlideIn 0.28s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes vtFadeOut {
  from {
    opacity: 1;
    transform: translateY(0);
  }
  to {
    opacity: 0;
    transform: translateY(-6px);
  }
}

@keyframes vtSlideIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Giảm chuyển động khi người dùng bật prefers-reduced-motion */
@media (prefers-reduced-motion: reduce) {
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }
}
</file>

