  position: absolute;
  top: 3px;
  bottom: 3px;
  left: 3px;
  width: calc(50% - 3px);
  border-radius: 8px;
  background: var(--white);
  box-shadow: var(--shadow-sm);
  transform: translateX(calc(var(--tab-offset, 0) * 100%));
