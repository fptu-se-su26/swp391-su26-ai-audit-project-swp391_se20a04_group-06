}

.mobileMenuItem.highlight {
  background: var(--ocean-p);
  color: var(--ocean);
}

/* ═══════════════════════════════════════════════════════════
   RESPONSIVE BREAKPOINTS
═══════════════════════════════════════════════════════════ */

/* ── Tablet landscape (1025–1280px): thu gọn padding nav ── */
@media (max-width: 1280px) and (min-width: 1025px) {
  .nav {
    padding: 0 20px;
  }
  .navBtn {
    padding: 8px 12px;
    font-size: 12px;
  }
  .postBtn,
  .loginBtn {
    padding: 8px 14px;
    font-size: 12px;
  }
  .logo {
    margin-right: 16px;
  }
}

/* ── Tablet portrait (769–1024px): thu nhỏ, ẩn tagline ── */
@media (max-width: 1024px) and (min-width: 769px) {
  .topBar {
    display: none;
  }
  .nav {
    padding: 0 16px;
    height: 60px;
  }
  .navScrolled {
    height: 52px;
  }
  .navBtn {
    padding: 7px 10px;
    font-size: 12px;
    gap: 4px;
  }
  .logoTagline {
    display: none;
  }
  .postBtn {
    padding: 8px 12px;
    font-size: 12px;
  }
  .loginBtn {
    padding: 8px 12px;
    font-size: 12px;
  }
  .logo {
    margin-right: 12px;
  }
}

/* ── Mobile (≤ 768px): hamburger menu ── */
@media (max-width: 768px) {
  .topBar {
    display: none !important;
  }
  .nav {
    height: 56px !important;
    padding: 0 16px !important;
  }
  .navScrolled {
    height: 56px !important;
  }
  .navLinks {
    display: none !important;
  }
  .actions {
    display: none !important;
  }
  .mobileActions {
    display: flex !important;
    margin-left: auto; /* 👈 đẩy hamburger về góc phải */
  }
  .logoMark {
    width: 32px !important;
    height: 32px !important;
    font-size: 17px !important;
  }
  .logoName {
    font-size: 14px !important;
  }
  .logoTagline {
    font-size: 7px !important;
  }
}

/* ── Phone nhỏ (≤ 480px): compact thêm ── */
@media (max-width: 480px) {
  .nav {
    padding: 0 12px !important;
  }
  .logoTagline {
    display: none !important;
  }
  .mobileMenu {
    padding: 10px 12px;
    top: 56px;
  }
  .mobileMenuItem {
    padding: 11px 14px;
    font-size: 13px;
  }
  /* Dropdown rộng hơn trên mobile nhỏ */
  .dropdown {
    width: min(200px, calc(100vw - 32px));
    right: -8px;
  }
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
