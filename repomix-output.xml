          }}
        >
          {n.preview || n.content}
        </div>
        {n.createdAt && (
          <div
            style={{
              fontSize: 11,
              color: C.muted,
              marginTop: 6,
              display: "flex",
              alignItems: "center",
              gap: 4,
            }}
          >
            <span>🕒</span>
