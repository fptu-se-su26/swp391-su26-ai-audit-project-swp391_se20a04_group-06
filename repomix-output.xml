/* App.css — Boutique Design System Token & Global Resets */

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ─── CSS VARIABLE SYSTEM (Warm Coastal Palette) ───────────────── */
:root {
  /* Tông màu biển sâu và cát ấm dã ngoại tạo sự tin cậy */
  --ocean: #081d2c; /* Sâu thẳm, tĩnh lặng */
  --ocean-l: #12405c;
  --ocean-p: #eaf3f8; /* Hơi hướng băng tuyết nhẹ */
  --ocean-d: #04101a;
  --coral: #d74a21; /* Cam san hô tự nhiên, không chói */
  --coral-l: #fdf0eb;
  --coral-d: #b23b17;
  --ok: #0f763e;
  --ok-l: #e6f4ea;
  --warn: #b86b00;
  --warn-l: #fef7e0;
  --dark: #08101c; /* Đen lạnh hải quân */
  --text: #1e293b;
  --text-2: #475569;
  --muted: #64748b;
  --border: #e2e8f0; /* Đường viền Hairline mảnh */
  --border-l: #f1f5f9;
  --bg: #faf6f0; /* Màu cát biển ấm áp thay cho màu xám trắng AI */
  --bg-2: #f1eadf;
  --white: #ffffff;

  /* Đổ bóng mảnh và mịn màng (Human-crafted shadows) */
  --shadow-sm: 0 1px 2px rgba(8, 16, 28, 0.04);
  --shadow-md:
    0 4px 16px rgba(8, 16, 28, 0.05), 0 2px 4px rgba(8, 16, 28, 0.02);
  --shadow-lg:
    0 10px 30px rgba(8, 16, 28, 0.06), 0 2px 8px rgba(8, 16, 28, 0.02);
  --shadow-xl: 0 20px 50px rgba(8, 16, 28, 0.08);

  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-xl: 16px;

  --font:
    "Be Vietnam Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  /* Easing chuẩn mượt mà thay thế linear */
  --transition: 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

/* ─── TYPOGRAPHY CONFIGURATION ───────────────────────────── */
html {
  font-size: 16px;
  -webkit-text-size-adjust: 100%;
}

body {
  font-family: var(--font);
  font-size: 0.9375rem;
  line-height: 1.6;
  color: var(--text);
  background-color: var(--bg);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-feature-settings:
    "kern" 1,
    "liga" 1,
    "calt" 1,
    "cv02" 1;
}

button,
input,
select,
textarea {
  font-family: var(--font);
}

/* ─── PREMIUM SCROLLBAR ─────────────────────────────────── */
::-webkit-scrollbar {
  width: 4px;
  height: 4px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: rgba(8, 29, 44, 0.12);
  border-radius: 99px;
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(8, 29, 44, 0.3);
}

/* ─── SHIMMER EFFECT ────────────────────────────────────── */
@keyframes shimmer {
  0% {
    background-position: -400px 0;
  }
  100% {
    background-position: 400px 0;
  }
}

.skeleton-shimmer {
  background-color: var(--border-l);
  background-image: linear-gradient(
    90deg,
    var(--border-l) 0%,
    var(--border) 40%,
    var(--border-l) 80%,
    var(--border-l) 100%
  );
  background-size: 800px 100%;
  background-repeat: no-repeat;
  animation: shimmer 1.6s ease-in-out infinite;
}

@keyframes pulse-danger {
  0% {
    box-shadow: 0 0 0 0 rgba(215, 74, 33, 0.4);
  }
  70% {
    box-shadow: 0 0 0 6px rgba(215, 74, 33, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(215, 74, 33, 0);
  }
}

.pulse-urgent {
  animation: pulse-danger 2s ease infinite;
}

/* ─── RESPONSIVE SYSTEM ─────────────────────────────────── */
@media (max-width: 640px) {
  .product-grid {
    grid-template-columns: 1fr 1fr !important;
    gap: 12px !important;
  }
}
@media (max-width: 380px) {
  .product-grid {
    grid-template-columns: 1fr !important;
  }
}
