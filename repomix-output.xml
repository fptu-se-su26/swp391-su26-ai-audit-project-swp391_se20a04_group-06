  --transition: 0.22s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ─── TYPOGRAPHY BASE ───────────────────────────────────── */
html {
  font-size: 16px;
  -webkit-text-size-adjust: 100%;
}

body {
  font-family: var(--font);
  font-size: 0.9375rem;
  line-height: 1.6;
