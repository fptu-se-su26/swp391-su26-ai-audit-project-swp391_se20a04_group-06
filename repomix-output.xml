                    borderRadius: 12,
                    border: "1px solid #F1F5F9",
                    minWidth: 90,
                  }}
                >
                  <div style={{ fontSize: 22, marginBottom: 2 }}>{s.emoji}</div>
                  <div style={{ fontSize: 18, fontWeight: 800, color: C.dark }}>
                    {s.value}
