# Leave empty in local/ngrok development so the browser uses the same-origin
# Vite proxy for /api and /socket.io. Never use localhost here for phone access.
VITE_API_URL=

# Google Identity Services OAuth client ID.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Floating contact buttons in the bottom-left corner.
VITE_CONTACT_FACEBOOK_URL=https://www.facebook.com/your-page
VITE_CONTACT_PHONE=0900000000
VITE_CONTACT_ZALO_URL=https://zalo.me/0900000000
