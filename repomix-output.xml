        {[
          ["stats", "📊 Thống kê"],
          ["users", "👥 Người dùng"],
          ["listings", "📋 Bài đăng"],
        ].map(([k, l]) => (
          <button
            key={k}
            onClick={() => setTab(k)}
            style={{
              padding: "8px 18px",
              borderRadius: 8,
              border: "none",
              cursor: "pointer",
              fontWeight: 700,
              fontSize: 13,
              background: tab === k ? C.ocean : "transparent",
              color: tab === k ? "#fff" : C.muted,
              fontFamily: "inherit",
            }}
          >
            {l}
          </button>
        ))}
      </div>

      {tab === "stats" && (
        <div
          style={{
            background: C.white,
            borderRadius: 12,
            border: `1px solid ${C.border}`,
            padding: 24,
          }}
        >
          <div style={{ fontWeight: 700, color: C.dark, marginBottom: 16 }}>
            Phân bố bài đăng
          </div>
          {[
            ["Hải sản tươi", total.fresh, C.coral],
            ["Hải sản khô", total.dried, C.warn],
