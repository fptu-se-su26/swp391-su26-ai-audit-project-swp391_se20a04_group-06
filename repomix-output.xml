                Gian hàng hiện chưa bày bán sản phẩm nào
              </div>
              <div style={{ fontSize: 12, marginTop: 4 }}>
                Hãy quay lại sau hoặc chuyển sang xem Đánh giá của người bán
                này.
              </div>
            </div>
          ) : (
            <div
              style={{
                display: "grid",
                gridTemplateColumns: "repeat(auto-fill,minmax(260px,1fr))",
